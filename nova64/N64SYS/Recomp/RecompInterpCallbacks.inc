        success = mmu->SD_Memory(addr, AsDWord(regs->m_GPR[mips_rt(opcVal)]).UDW);
    }
    if (mips_rt(opcVal) != 0) {
        AsDWord(regs->m_GPR[mips_rt(opcVal)]).UDW = success ? 1 : 0;
