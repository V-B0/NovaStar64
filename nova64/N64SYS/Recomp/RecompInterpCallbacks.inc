// DCFC1/DCTC1 (rs=3/7): check CU1 first, then fire FPE if usable
static void Interp_COP1_DCFC1_DCTC1(CRegisters* regs, uint32_t /*opcVal*/) {
    if (CheckCop1Unusable(regs)) return;
