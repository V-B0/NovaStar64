    R4300iOps op;
    op.Value = opcVal;
    if (AsDWord(regs->m_GPR[mips_rs(opcVal)]).UDW >= AsDWord(regs->m_GPR[mips_rt(opcVal)]).UDW)
        regs->TriggerException(static_cast<uint32_t>(ExceptionCode::Trap));
}

