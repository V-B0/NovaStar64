    AsDWord(regs->m_GPR[31]).DW = static_cast<int64_t>(regs->GetLinkAddress(static_cast<int32_t>(pc + 8)));
    SetPC(regs, (rs >= 0) ? (pc + 4 + offset) : (pc + 8));
