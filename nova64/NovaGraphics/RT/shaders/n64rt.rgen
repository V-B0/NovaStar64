// n64rt.rgen — N64 hardware raytracing: primary ray generation
// SPDX-License-Identifier: MIT
#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT u_tlas;
layout(set = 0, binding = 1, rgba8) uniform image2D u_output;

struct RayPayload {
    vec4 color;
    bool hit;
};
layout(location = 0) rayPayloadEXT RayPayload g_payload;

void main() {
    const ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    const ivec2 size  = ivec2(gl_LaunchSizeEXT.xy);

    // Reconstruct NDC from pixel coordinate.
    const vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    const vec2 ndc = uv * 2.0 - 1.0;

    // Orthographic-ish view ray along -Z (approximates N64's fixed projection).
    const vec3 origin    = vec3(ndc.x, -ndc.y, 1.0);
    const vec3 direction = vec3(0.0, 0.0, -1.0);

    g_payload.color = vec4(0.0, 0.0, 0.0, 1.0);
    g_payload.hit   = false;

    traceRayEXT(
        u_tlas,
        gl_RayFlagsOpaqueEXT,
        0xFF,       // cull mask
        0,          // sbtRecordOffset
        0,          // sbtRecordStride
        0,          // missIndex
        origin,
        0.001,      // tMin
        direction,
        1000.0,     // tMax
        0           // payload location
    );

    imageStore(u_output, pixel, g_payload.color);
}
